# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://mtr-project.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Search locale (defaults are worldwide). Example for Hong Kong: SEARCH_REGION=hk-en SEARCH_GL=hk
SEARCH_REGION=wt-wt
SEARCH_GL=us
SEARCH_HL=en
# Optional: Serper Google Search (used like SafetyAwarenessPulse for labour.gov.hk / world news).
# Without it, web_search falls back to DuckDuckGo.
# SERPER_API_KEY=

# Email
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SQLite extracts DB (default: data/extracts.db)
# DB_PATH=
